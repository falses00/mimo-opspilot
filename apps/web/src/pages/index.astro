---
const title = 'Opspilot';
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL || '';
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>${title}</title>
  <style>
    :root { --bg: #0b0d12; --surface: #11151d; --card: #171c26; --gold: #d4af37; --text: #f7f2e8; --muted: #918a7c; --border: rgba(255,255,255,0.06); }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .nav { position: sticky; top: 0; z-index: 50; padding: 0.75rem 1.5rem; background: rgba(11,13,18,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
    .nav-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; }
    .nav-brand { font-size: 1.25rem; font-weight: 700; color: var(--gold); }
    .hero { text-align: center; padding: 4rem 0 3rem; background: radial-gradient(circle at 50% 0%, rgba(212,175,55,0.12), transparent 50%); }
    .hero h1 { font-size: 3rem; font-weight: 800; background: linear-gradient(135deg, var(--gold), #b8922f); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .hero p { color: var(--muted); max-width: 600px; margin: 1rem auto 0; }
    .main { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 768px) { .grid { grid-template-columns: 1fr; } }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 1rem; padding: 1.5rem; }
    .card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 1rem; }
    textarea, input { width: 100%; padding: 0.75rem; border-radius: 0.5rem; background: var(--surface); border: 1px solid var(--border); color: var(--text); font-size: 0.875rem; font-family: inherit; }
    textarea { min-height: 100px; resize: vertical; }
    textarea:focus, input:focus { outline: none; border-color: var(--gold); }
    .btn { padding: 0.75rem 1.5rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.875rem; border: none; cursor: pointer; }
    .btn-primary { background: var(--gold); color: var(--bg); }
    .btn-secondary { background: var(--surface); color: var(--muted); border: 1px solid var(--border); }
    .actions { display: flex; gap: 0.75rem; margin-top: 1rem; }
    .hidden { display: none !important; }
    .badge { display: inline-flex; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; background: rgba(212,175,55,0.1); color: var(--gold); border: 1px solid rgba(212,175,55,0.3); }
    .item { padding: 0.75rem; background: var(--surface); border-radius: 0.5rem; margin-bottom: 0.5rem; }
  </style>
</head>
<body>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand">${title}</a>
      <div style="display:flex;gap:1rem;">
        <a href="https://github.com/falses00/mimo-opspilot" target="_blank" style="color:var(--muted);text-decoration:none;font-size:0.875rem;">GitHub</a>
      </div>
    </div>
  </nav>

  <section class="hero">
    <h1>${title}</h1>
    <p>MIMO 工具生态独立项目</p>
  </section>

  <main class="main">
    <div class="grid">
      <div class="card">
        <h3>📝 输入</h3>
        <textarea id="input" placeholder="输入内容..."></textarea>
        <div class="actions">
          <button class="btn btn-primary" id="btn-run">运行</button>
          <button class="btn btn-secondary" id="btn-example">示例</button>
        </div>
      </div>
      <div class="card">
        <h3>📊 结果</h3>
        <div style="margin-bottom:1rem;">
          <span class="badge" id="mode-badge">${apiBaseUrl ? 'API 模式' : '本地模式'}</span>
        </div>
        <div id="empty" style="text-align:center;padding:2rem;color:var(--muted);">
          <div style="font-size:2rem;">📊</div>
          <p>点击运行查看结果</p>
        </div>
        <div id="result" class="hidden"></div>
      </div>
    </div>
  </main>

  <script>
    const apiBaseUrl = '${apiBaseUrl}';
    const example = '示例数据：这是一个测试输入，用于演示功能。';
    
    document.getElementById('btn-example').addEventListener('click', () => {
      document.getElementById('input').value = example;
    });
    
    document.getElementById('btn-run').addEventListener('click', async () => {
      const input = document.getElementById('input').value.trim();
      if (!input) { alert('请输入内容'); return; }
      
      document.getElementById('empty').classList.add('hidden');
      document.getElementById('result').classList.remove('hidden');
      document.getElementById('result').innerHTML = '<div style="color:var(--muted);">处理中...</div>';
      
      // Simulate processing
      await new Promise(r => setTimeout(r, 500));
      
      document.getElementById('result').innerHTML = 
        '<div class="item"><strong>输入:</strong> ' + input.substring(0, 100) + '</div>' +
        '<div class="item"><strong>状态:</strong> 处理完成</div>' +
        '<div class="item"><strong>模式:</strong> ' + (apiBaseUrl ? 'API' : '本地') + '</div>';
    });
  </script>
</body>
</html>
