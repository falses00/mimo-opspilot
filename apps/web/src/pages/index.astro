---
import SplineScene from '../components/SplineScene.astro';
import { defaultSplineScene } from '../data/splineScenes';

const title = 'OpsPilot - API 日志与服务监控台';
const description = 'API 健康检查、合约校验、日志分析、事故复盘、服务状态 dashboard。';
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <style>
    :root { --bg: #0c1017; --surface: #121824; --card: #171f2c; --gold: #d4af37; --text: #f7f2e8; --muted: #a7a194; --border: rgba(255,255,255,0.08); }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Inter, system-ui, sans-serif; color: var(--text); background: radial-gradient(circle at 50% 0%, rgba(212,175,55,0.14), transparent 32%), linear-gradient(135deg, #0c1017 0%, #17202b 56%, #231f18 100%); min-height: 100vh; }
    .container { max-width: 1120px; margin: 0 auto; padding: 5rem 1.5rem; }
    .eyebrow { display: inline-flex; padding: 0.4rem 0.8rem; border-radius: 999px; color: var(--gold); border: 1px solid rgba(212,175,55,0.28); background: rgba(212,175,55,0.08); font-size: 0.78rem; font-weight: 700; }
    h1 { margin: 1.2rem 0 0.8rem; font-size: clamp(2.2rem, 6vw, 4.8rem); line-height: 1; letter-spacing: 0; }
    .lead { max-width: 720px; color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
    .scene { margin: 2.5rem 0; }
    .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
    .card { padding: 1.25rem; border-radius: 0.75rem; background: rgba(23,31,44,0.76); border: 1px solid var(--border); }
    .card strong { display: block; margin-bottom: 0.4rem; color: var(--gold); }
    .card span { color: var(--muted); font-size: 0.92rem; line-height: 1.55; }
    @media (max-width: 760px) { .container { padding: 3rem 1rem; } .grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <main class="container">
    <span class="eyebrow">temporary-demo-scene</span>
    <h1>OpsPilot</h1>
    <p class="lead">{description} 当前使用公开 Spline demo scene 验证真实嵌入与性能，后续替换为自有品牌场景。</p>
    <div class="scene">
      <SplineScene sceneUrl={defaultSplineScene.sceneUrl} title="OpsPilot temporary 3D scene" height="360px" />
    </div>
    <section class="grid">
      <div class="card"><strong>Health</strong><span>聚合 API 健康、延迟、状态和回归信号。</span></div>
      <div class="card"><strong>Logs</strong><span>把日志错误、告警和事故线索整理成可复盘视图。</span></div>
      <div class="card"><strong>Fallback</strong><span>移动端与加载失败时自动保留 CSS 视觉。</span></div>
    </section>
  </main>
</body>
</html>
